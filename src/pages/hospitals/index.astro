---
import Layout from "../../layouts/MainLayout.astro";
import {
	HOSPITALS,
	COUNTRIES,
	byCountrySize,
	totalBeds,
	totalStaffed,
	totalStaff,
} from "../../data/hospitals";

const byCountry = byCountrySize.map(({ country }) => ({
	country,
	facilities: HOSPITALS.filter((h) => h.country === country),
}));

const fmt = (n: number) => n.toLocaleString("en-GB");

// ── the footprint panel ────────────────────────────────────────────────────
// Grouped by region rather than by country, because a reader asking "where do
// you operate?" wants West Africa as a whole, not eight separate headings.
//
// EVERYTHING HERE IS DERIVED. Region comes from countryCode, the filled dot
// comes from `level`, and the totals come from hospitals.ts. Nothing is typed
// in by hand, so this panel cannot drift out of step with the facilities list
// when the real data file replaces the placeholders.
//
// An unmapped country falls back to being its own group rather than being
// dropped, so a new country in the real file still appears somewhere.
const REGION_OF: Record<string, string> = {
	NG: "West Africa", GH: "West Africa", CI: "West Africa", SN: "West Africa",
	GM: "West Africa", SL: "West Africa", LR: "West Africa", BF: "West Africa",
	KE: "East Africa", TZ: "East Africa", UG: "East Africa", ET: "East Africa",
	RW: "East Africa", SS: "East Africa",
	ZA: "Southern Africa", NA: "Southern Africa", BW: "Southern Africa",
	ZW: "Southern Africa", MZ: "Southern Africa",
	MA: "North Africa", EG: "North Africa", DZ: "North Africa", TN: "North Africa",
	PH: "Asia", IN: "Asia", PK: "Asia", BD: "Asia", LK: "Asia", NP: "Asia",
};

const REGION_ORDER = [
	"West Africa",
	"East Africa",
	"Southern Africa",
	"North Africa",
	"Asia",
];

const groups = new Map<string, typeof HOSPITALS>();
for (const h of HOSPITALS) {
	const region = REGION_OF[h.countryCode] ?? h.country;
	if (!groups.has(region)) groups.set(region, []);
	groups.get(region)!.push(h);
}

// Known regions first in geographic order, then anything unexpected, sorted.
const byRegion = [
	...REGION_ORDER.filter((r) => groups.has(r)).map((r) => [r, groups.get(r)!] as const),
	...[...groups.entries()]
		.filter(([r]) => !REGION_ORDER.includes(r))
		.sort((a, b) => a[0].localeCompare(b[0])),
];

const firstOpening = HOSPITALS.reduce((a, b) => (b.opened < a.opened ? b : a)).opened;

const ageOf = (h: Hospital) => {
	const start = new Date().getFullYear() - h.opened;
	if (start < 3) return "New";
	if (start < 8) return "Expanding";
	return "Established";
};
---

<Layout
	title="Hospitals and clinics | MedicSupport Network"
	description={`${HOSPITALS.length} hospitals and clinics operated by MedicSupport Network across Africa and Asia — ${fmt(totalBeds)} beds in Ghana, Nigeria, Kenya, South Africa, the Philippines and Morocco.`}
>
	<div class="bg-[#fbf8f3] text-[#1a1714] min-h-[60vh]">
		<div class="max-w-[1080px] mx-auto px-6 sm:px-10 pt-16 pb-20">

			<header class="max-w-[60ch] mb-12">
				<h1
					class="font-[Georgia,serif] text-[clamp(2.4rem,6vw,3.6rem)] leading-[1.03] tracking-[-0.015em] mb-5"
				>
					The facilities we operate.
				</h1>
				<p class="text-[1.12rem] text-[#514a42]">
					MedicSupport runs {HOSPITALS.length} hospitals and clinics across Africa and Asia.
					These are our own facilities, licensed in their respective countries and staffed by our
					own clinical workforce.
				</p>
			</header>

			<!-- group totals -->
			<div class="grid grid-cols-2 sm:grid-cols-4 border-y border-[#1a1714] mb-16">
				<div class="py-6 pr-6 border-r border-[#e4ddd4]">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{HOSPITALS.length}</p>
					<p class="text-[0.72rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Facilities</p>
				</div>
				<div class="py-6 px-6 border-r border-[#e4ddd4]">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{COUNTRIES.length}</p>
					<p class="text-[0.72rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Countries</p>
				</div>
				<div class="py-6 px-6 border-r border-[#e4ddd4]">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{fmt(totalBeds)}</p>
					<p class="text-[0.72rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Licensed beds</p>
				</div>
				<div class="py-6 pl-6">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{fmt(totalStaffed)}</p>
					<p class="text-[0.72rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Staffed beds</p>
				</div>
			</div>

			<!-- where we operate, at a glance -->
			<aside class="bg-[#0f3d57] border border-white/15 px-7 sm:px-8 py-7 mb-16">
				<p class="text-[0.68rem] tracking-[0.16em] uppercase font-bold text-[#8fb6c9] mb-7">
					Where we operate
				</p>

				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
					{
						byRegion.map(([region, facilities]) => (
							<div class="border-t border-white/25 pt-4">
								<h3 class="text-[0.78rem] tracking-[0.1em] uppercase font-bold mb-3">
									{region}
								</h3>
								<ul class="space-y-2">
									{facilities.map((h) => (
										<li class="flex items-baseline gap-2 text-[0.84rem] leading-snug text-[#b9cbd9]">
											<span
												class={`shrink-0 w-1.5 h-1.5 rounded-full translate-y-[-1px] ${
													h.level === "Tertiary"
														? "bg-[#0086C4]"
														: "bg-transparent border border-white/45"
												}`}
											/>
											<span>{h.name}</span>
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>

				<div class="mt-7 pt-5 border-t border-white/15 flex flex-wrap gap-x-8 gap-y-3 text-[0.84rem] text-[#c4d9e4]">
					<span><span class="text-[#8fb6c9]">Beds</span>{' '}
						<b class="text-white">{fmt(totalBeds)}</b></span>
					<span><span class="text-[#8fb6c9]">Staffed</span>{' '}
						<b class="text-white">{fmt(totalStaffed)}</b></span>
					<span><span class="text-[#8fb6c9]">Workforce</span>{' '}
						<b class="text-white">~{fmt(totalStaff)}</b></span>
					<span><span class="text-[#8fb6c9]">Since</span>{' '}
						<b class="text-white">{firstOpening}</b></span>
				</div>

				<p class="mt-4 text-[0.7rem] text-[#8fb6c9] flex flex-wrap gap-x-5 gap-y-1">
					<span class="flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full bg-[#0086C4]"></span>
						Tertiary referral centre
					</span>
					<span class="flex items-center gap-1.5">
						<span class="w-1.5 h-1.5 rounded-full border border-white/45"></span>
						Secondary and community
					</span>
				</p>
			</aside>

			<!-- grouped by country -->
			{byCountry.map(({ country, facilities }) => (
				<section class="mb-14">
					<div class="flex items-baseline gap-4 mb-5">
						<h2 class="font-[Georgia,serif] text-[1.7rem] tracking-[-0.01em]">{country}</h2>
						<span class="text-[0.75rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">
							{facilities.length} {facilities.length === 1 ? "facility" : "facilities"}
						</span>
						<span class="flex-1 h-px bg-[#e4ddd4]"></span>
					</div>

					<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
						{facilities.map((h) => (
							<a
								href={`/hospitals/${h.slug}`}
								class="group border border-[#e4ddd4] bg-white p-6 no-underline transition-colors hover:border-[#0086C4]"
							>
								<div class="flex items-start justify-between gap-3 mb-3">
									<h3 class="font-bold text-[1.1rem] leading-snug text-[#1a1714] group-hover:text-[#0086C4]">
										{h.name}
									</h3>
									{h.status === "New" && (
										<span class="shrink-0 text-[0.6rem] tracking-[0.1em] uppercase font-bold text-white bg-[#0086C4] px-2 py-1">
											New
										</span>
									)}
								</div>

								<p class="text-[0.88rem] text-[#8a8078] mb-4">{h.city} · {h.level}</p>

								<p class="text-[0.88rem] text-[#514a42] leading-relaxed mb-5">{h.blurb}</p>

								<div class="flex items-center justify-between border-t border-[#e4ddd4] pt-4 text-[0.8rem]">
									<span class="text-[#8a8078]">{fmt(h.beds)} beds · from {h.opened}</span>
									<span class="text-[#0086C4] font-bold">View →</span>
								</div>
							</a>
						))}
					</div>
				</section>
			))}

			<!-- workforce -->
			<div class="border-l-2 border-[#0086C4] pl-5 my-14">
				<p class="text-[1.02rem] text-[#514a42] leading-relaxed max-w-[62ch]">
					Across these facilities MedicSupport employs approximately
					<strong class="text-[#1a1714]">{fmt(totalStaff)} clinical and support staff</strong>
					— doctors, nurses, midwives, paramedics and allied health professionals. Our clinicians
					work in our hospitals; some are seconded to hospitals and health systems in Europe and
					America, where the same standards apply.
				</p>
			</div>

		</div>
	</div>
</Layout>