---
import Layout from "../layouts/MainLayout.astro";
import {
	HOSPITALS,
	COUNTRIES,
	totalBeds,
	totalStaffed,
	totalStaff,
} from "../data/hospitals";
import { LEADERSHIP } from "../data/leadership";

const fmt = (n: number) => n.toLocaleString("en-GB");

// The growth story is derived from the facilities file, so it stays true when
// the real data replaces the placeholders. Nothing here is hand-maintained.
const byYear = new Map<number, string[]>();
for (const h of HOSPITALS) {
	if (!byYear.has(h.opened)) byYear.set(h.opened, []);
	byYear.get(h.opened)!.push(`${h.name} — ${h.city}`);
}
const timeline = [...byYear.entries()].sort((a, b) => a[0] - b[0]);
const firstYear = timeline[0][0];
const lastYear = timeline[timeline.length - 1][0];
// Derived, never hardcoded. The day the real data file lands with a different
// founding year, the headline and the intro follow it. A hardcoded "Eighteen
// years" beside a timeline ending in 2021 is exactly the kind of contradiction
// this page must not contain.
const THIS_YEAR = new Date().getFullYear();
const yearsTrading = THIS_YEAR - firstYear;
const word = (n: number) => ["Zero","One","Two","Three","Four","Five","Six","Seven","Eight","Nine","Ten",
  "Eleven","Twelve","Thirteen","Fourteen","Fifteen","Sixteen","Seventeen","Eighteen","Nineteen",
  "Twenty"][n] ?? String(n);

// The country of the EARLIEST opening — not COUNTRIES[0], which is merely
// array order and gave "our first facility in Nigeria in 2007" when the 2007
// facility was in Ghana.
const earliest = HOSPITALS.reduce((a, b) => (b.opened < a.opened ? b : a));
const firstCountry = earliest.country;
const countriesEntered = new Map<string, number>();
for (const h of HOSPITALS) {
	if (!countriesEntered.has(h.country)) {
		countriesEntered.set(h.country, h.opened);
	}
}

const principles = [
	{
		title: "One standard, not eighteen",
		body: "Every facility runs to the same clinical and governance standard, set once at group level. A clinician should not get a different hospital because they were sent to a different country.",
	},
	{
		title: "We publish what we checked",
		body: "Every clinician we employ is verified against their registering body, and the resulting record is publicly checkable by anyone, without an account. A credential we have not confirmed is never marked as verified.",
	},
	{
		title: "The employer stays the employer",
		body: "When one of our clinicians works in a hospital abroad, we remain their employer. It is the only arrangement that leaves somebody accountable when something goes wrong.",
	},
	{
		title: "Open a hospital where the gap is",
		body: "Most of our sites were not opened because the market was attractive. They were opened because a region had no dependable secondary or emergency care and we could stand one up.",
	},
];
---

<Layout
	title="About the group | MedicSupport Network"
	description="MedicSupport Network has operated hospitals and clinics across Africa and Asia for 18 years — 18 facilities, 6 countries, one clinical standard. Our governance, our leadership and how the group is run."
>
	<div class="bg-[#fbf8f3] text-[#1a1714] min-h-[60vh]">
		<div class="max-w-[880px] mx-auto px-6 sm:px-10 pt-16 pb-20">

			<header class="mb-14">
				<p class="text-[0.68rem] tracking-[0.16em] uppercase font-bold text-[#8a8078] mb-5">
					About the group
				</p>
				<h1
					class="font-[Georgia,serif] text-[clamp(2.4rem,6vw,3.7rem)] leading-[1.02] tracking-[-0.02em] mb-7"
				>
					{word(yearsTrading)} years of building hospitals.
				</h1>
				<p class="text-[1.2rem] text-[#514a42] max-w-[58ch] leading-relaxed">
					MedicSupport Network owns and operates hospitals and clinics across Africa and Asia.
					We opened our first facility in {firstCountry} in {firstYear}. We now run {HOSPITALS.length}{" "}
					across {COUNTRIES.length} countries, employ approximately {fmt(totalStaff)} people, and
					second our own clinicians to hospitals in Europe and America.
				</p>
			</header>

			<!-- numbers -->
			<div class="grid grid-cols-2 sm:grid-cols-4 border-y border-[#1a1714] mb-16">
				<div class="py-6 pr-5 border-r border-[#e4ddd4]">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{HOSPITALS.length}</p>
					<p class="text-[0.7rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Facilities</p>
				</div>
				<div class="py-6 px-5 border-r border-[#e4ddd4]">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{COUNTRIES.length}</p>
					<p class="text-[0.7rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Countries</p>
				</div>
				<div class="py-6 px-5 border-r border-[#e4ddd4]">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{fmt(totalBeds)}</p>
					<p class="text-[0.7rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Licensed beds</p>
				</div>
				<div class="py-6 pl-5">
					<p class="font-[Georgia,serif] text-[2.1rem] leading-none mb-2">{fmt(totalStaffed)}</p>
					<p class="text-[0.7rem] tracking-[0.12em] uppercase font-bold text-[#8a8078]">Staffed</p>
				</div>
			</div>

			<!-- growth, derived from the facilities file -->
			<section class="mb-16">
				<h2
					class="text-[0.68rem] tracking-[0.18em] uppercase font-bold text-[#8a8078] mb-8 pt-6 border-t border-[#1a1714]"
				>
					How the group grew
				</h2>
				<p class="text-[0.98rem] text-[#514a42] mb-8 max-w-[62ch] leading-relaxed">
					We have opened a hospital in most years since {firstYear}. The pattern is not
					accidental — we build where a region has no dependable care, and we expand
					existing sites before we open new ones.
				</p>
				<ol class="relative pl-8">
					{/*
						The spine. Kept as a single absolutely-positioned rule rather than a
						per-item border so a year with three openings lines up correctly.
					*/}
					<span class="absolute left-[5px] top-2 bottom-2 w-px bg-[#e4ddd4]" aria-hidden="true"></span>
					{timeline.map(([year, names]) => (
						<li class="relative pb-7 last:pb-0">
							<span
								class="absolute left-[-32px] top-[7px] w-[13px] h-[13px] rounded-full border-2 border-[#0086C4] bg-[#fbf8f3]"
								aria-hidden="true"
							></span>
							<div class="flex items-baseline gap-4 mb-1.5">
								<span class="font-[Georgia,serif] text-[1.35rem] leading-none">{year}</span>
								{names.length > 1 && (
									<span class="text-[0.7rem] tracking-[0.1em] uppercase font-bold text-[#8a8078]">
										{names.length} opened
									</span>
								)}
							</div>
							<ul>
								{names.map((n) => (
									<li class="text-[0.92rem] text-[#514a42] py-0.5">{n}</li>
								))}
							</ul>
						</li>
					))}
					<li class="relative">
						<span
							class="absolute left-[-32px] top-[7px] w-[13px] h-[13px] rounded-full bg-[#0086C4]"
							aria-hidden="true"
						></span>
						<div class="flex items-baseline gap-4">
							<span class="font-[Georgia,serif] text-[1.35rem] leading-none">{THIS_YEAR}</span>
							<span class="text-[0.7rem] tracking-[0.1em] uppercase font-bold text-[#0086C4]">
								Today
							</span>
						</div>
					</li>
				</ol>
			</section>

			<!-- countries entered -->
			<section class="mb-16">
				<h2
					class="text-[0.68rem] tracking-[0.18em] uppercase font-bold text-[#8a8078] mb-7 pt-6 border-t border-[#1a1714]"
				>
					Where we operate
				</h2>
				<div class="grid sm:grid-cols-2 gap-x-12">
					{[...countriesEntered.entries()]
						.sort((a, b) => a[1] - b[1])
						.map(([country, year]) => {
							const n = HOSPITALS.filter((h) => h.country === country).length;
							return (
								<div class="flex justify-between items-baseline gap-4 py-3 border-b border-[#e4ddd4]">
									<span class="font-bold text-[1.05rem]">{country}</span>
									<span class="text-[0.85rem] text-[#8a8078] text-right">
										{n} {n === 1 ? "facility" : "facilities"} · from {year}
									</span>
								</div>
							);
						})}
				</div>
			</section>

			<!-- how we run -->
			<section class="mb-16">
				<h2
					class="text-[0.68rem] tracking-[0.18em] uppercase font-bold text-[#8a8078] mb-7 pt-6 border-t border-[#1a1714]"
				>
					How we run it
				</h2>
				<div class="grid sm:grid-cols-2 gap-x-12 gap-y-9">
					{principles.map((p) => (
						<div>
							<h3 class="font-bold text-[1.05rem] mb-2 leading-snug">{p.title}</h3>
							<p class="text-[0.95rem] text-[#514a42] leading-relaxed">{p.body}</p>
						</div>
					))}
				</div>
			</section>

			<!-- leadership: roles, not invented names -->
			<section class="mb-16">
				<h2
					class="text-[0.68rem] tracking-[0.18em] uppercase font-bold text-[#8a8078] mb-4 pt-6 border-t border-[#1a1714]"
				>
					Group leadership
				</h2>
				<p class="text-[0.95rem] text-[#514a42] mb-8 max-w-[62ch] leading-relaxed">
					Accountability sits with named officers. These are the roles that hold it.
				</p>
				<div class="grid sm:grid-cols-2 gap-x-12 gap-y-9">
					{LEADERSHIP.map((l) => (
						<div>
							<h3 class="font-[Georgia,serif] text-[1.2rem] mb-2 leading-snug">{l.role}</h3>
							<p class="text-[0.95rem] text-[#514a42] leading-relaxed">{l.remit}</p>
						</div>
					))}
				</div>
			</section>

			<!-- CTA -->
			<section class="border-t border-[#1a1714] pt-10">
				<h2 class="font-[Georgia,serif] text-[1.9rem] leading-tight mb-3 tracking-[-0.01em]">
					Governance, registration and accounts.
				</h2>
				<p class="text-[1rem] text-[#514a42] mb-7 max-w-[60ch] leading-relaxed">
					Clinical governance documentation, group structure, registration evidence for
					any of our facilities and audited financial information are provided on request.
				</p>
				<div class="flex flex-wrap gap-3.5">
					<a
						href="mailto:info@medicsupport.network?subject=Governance%20and%20registration%20information%20request"
						class="bg-[#0f3d57] text-white px-7 py-3.5 font-bold text-[1rem] no-underline"
						>Request documentation</a
					>
					<a
						href="/hospitals"
						class="border border-[#0f3d57] text-[#0f3d57] px-7 py-3.5 font-bold text-[1rem] no-underline"
						>See our facilities</a
					>
				</div>
			</section>

		</div>
	</div>
</Layout>