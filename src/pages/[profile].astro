---
import { getCollection } from "astro:content";
import Layout from "../layouts/MainLayout.astro";
import VerificationBar from "../components/profile/VerificationBar.astro";
import CredentialRow from "../components/profile/CredentialRow.astro";

export async function getStaticPaths() {
	const clinicians = await getCollection("clinicians");
	return clinicians.map((clinician) => ({
		params: { profile: clinician.data.slug },
		props: { clinician },
	}));
}

const { clinician } = Astro.props;
const d = clinician.data;

const fmt = (date: Date) =>
	date.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
const yr = (date: Date) => date.getFullYear().toString();

const yearsOfPractice = Math.round(
	d.career.reduce((acc, r) => acc + (r.to.getTime() - r.from.getTime()) / 31_557_600_000, 0),
);

const marketLabel = (s: string) =>
	s === "active" ? "Licensed" : s === "in_progress" ? "In progress" : s === "not_started" ? "Not started" : s;

const dotClass = (s: string) =>
	s === "active" ? "bg-[#1f7a4d]" : s === "in_progress" ? "bg-[#0086C4]" : "bg-[#e4ddd4]";

const lede = (clinician.body ?? "").trim();
---

<Layout
	title={`${d.name} — ${d.profession} | MedicSupport Network`}
	description={`Verified credential record for ${d.name}, ${d.profession} (${d.specialism}). Registration checked against the issuing body on ${fmt(d.record.verifiedOn)}.`}
>
	<VerificationBar record={d.record} references={d.credentials.filter((c) => c.reference).map((c) => c.reference)} />

	<div class="bg-[#fbf8f3] text-[#1a1714] min-h-[60vh]">
		<div class="max-w-[760px] mx-auto px-6 sm:px-10">

			<!-- opening -->
			<section class="pt-20 pb-16">
				<h1 class="font-[Georgia,serif] text-[clamp(2.9rem,7vw,4.4rem)] leading-[0.98] tracking-[-0.015em] mb-6">
					{yearsOfPractice} years<br />on the ward.
				</h1>
				<p class="text-[1.18rem] text-[#514a42] max-w-[40ch] mb-10">{lede}</p>

				<figure class="relative bg-[#0f3d57] aspect-[16/7] overflow-hidden rounded-sm">
					<div
						class="absolute inset-0"
						style="background:radial-gradient(circle at 22% 40%,#4a7f9b 0 13%,transparent 13.5%),radial-gradient(ellipse 16% 24% at 22% 96%,#4a7f9b 0 100%,transparent 100.5%),linear-gradient(150deg,#1d4a63,#0f3d57)"
					>
					</div>
					<figcaption
						class="absolute left-5 bottom-4 text-xs text-[#bcd3e4] tracking-[0.03em]"
					>
						Portrait supplied by the clinician — no stock faces on verified records.
					</figcaption>
				</figure>
			</section>

			<!-- credentials -->
			<section class="pb-16">
				<h2
					class="text-[0.68rem] tracking-[0.18em] uppercase font-bold text-[#8a8078] mb-7"
				>
					Credentials on file
				</h2>
				<div class="border-t border-[#1a1714]">
					{d.credentials.map((c) => <CredentialRow credential={c} fmt={fmt} />)}
				</div>
			</section>

			<!-- career -->
			<section class="pb-16">
				<h2 class="text-[0.68rem] tracking-[0.18em] uppercase font-bold text-[#8a8078] mb-7">
					Career
				</h2>
				{d.career.map((role) => (
					<div class="relative pl-9 pb-9 last:pb-0">
						<div
							class="absolute left-1 top-[9px] bottom-0 w-px bg-[#e4ddd4] last:hidden"
						>
						</div>
						<div
							class:list={[
								"absolute left-0 top-2 w-[13px] h-[13px] rounded-full border-2 border-[#0086C4]",
								role.current ? "bg-[#0086C4]" : "bg-[#fbf8f3]",
							]}
						>
						</div>
						<p class="mono text-[0.82rem] text-[#8a8078] tracking-[0.05em] mb-1.5">
							{yr(role.from)} — {yr(role.to)}
						</p>
						<p class="font-[Georgia,serif] text-[1.3rem] leading-tight mb-1">
							{role.role}
						</p>
						<p class="text-[#514a42]">
							{role.org}{role.location ? `, ${role.location}` : ""}
						</p>
					</div>
				))}
			</section>

			<!-- three quiet columns -->
			<section class="pb-16">
				<div class="grid grid-cols-1 sm:grid-cols-[0.95fr_1.25fr_1fr] gap-x-9 gap-y-9">
					<div>
						<h3 class="text-[0.68rem] tracking-[0.14em] uppercase font-bold text-[#8a8078] mb-4">
							Scope
						</h3>
						{d.scope.map((s) => (
							<div class="flex justify-between items-baseline gap-3 py-2 text-[0.95rem] border-b border-[#e4ddd4]">
								<span>{s.specialism}</span><span class="text-[#8a8078] text-[0.82rem] whitespace-nowrap">{s.years} yrs</span>
							</div>
						))}
					</div>
					<div>
						<h3 class="text-[0.68rem] tracking-[0.14em] uppercase font-bold text-[#8a8078] mb-4">
							Eligible markets
						</h3>
						{d.markets.map((m) => (
							<div class="flex justify-between items-baseline gap-3 py-2 text-[0.95rem] border-b border-[#e4ddd4]">
								<span class="flex items-center gap-2 min-w-0">
									<i class:list={["w-2 h-2 rounded-full shrink-0", dotClass(m.status)]}></i>{m.market}
								</span>
								<span class="text-[#8a8078] text-[0.82rem] whitespace-nowrap shrink-0">{marketLabel(m.status)}</span>
							</div>
						))}
					</div>
					<div>
						<h3 class="text-[0.68rem] tracking-[0.14em] uppercase font-bold text-[#8a8078] mb-4">
							Documents
						</h3>
						{d.documents.map((doc) => (
							<div class="flex justify-between items-baseline gap-3 py-2 text-[0.95rem] border-b border-[#e4ddd4]">
								<span class="min-w-0">{doc.document}</span><span class="text-[#8a8078] text-[0.82rem] whitespace-nowrap shrink-0 capitalize">{doc.status}</span>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- actions -->
			<section class="pb-20 flex flex-wrap items-center gap-3.5">
				<a
					href={`mailto:employers@medicsupport.network?subject=Request%20contact%20%E2%80%94%20${encodeURIComponent(d.name)}`}
					class="bg-[#0f3d57] text-white px-7 py-3.5 font-bold text-[1rem] no-underline">Request this clinician</a
				>
				<a
					href="mailto:employers@medicsupport.network?subject=Verified%20record%20download%20%E2%80%94%20MedicSupport"
					class="border border-[#0f3d57] text-[#0f3d57] px-7 py-3.5 font-bold text-[1rem] no-underline"
					>Download verified record</a
				>
				<p class="text-sm text-[#8a8078] ml-auto max-w-[34ch] leading-snug">
					Contact details are released only to employers the clinician nominates.
				</p>
			</section>
		</div>
	</div>
</Layout>