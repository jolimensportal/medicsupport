---
import Logo from "./Logo.astro";
import { ESTABLISHED } from "../data/legal";
const copyrightFrom = ESTABLISHED;
const copyrightTo = new Date().getFullYear();
---

<footer class="footer w-full bg-[#F2FAFF] gap-0 dark:bg-black">
  <div class="footer-top w-full py-15">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_2fr] gap-10">
        <div>
          <Logo variant="auto" />
          <p class="mt-4">
            We own and operate hospitals and clinics across Africa and Asia, and
            second our own clinicians to hospitals in Europe and America.
          </p>

        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-10">
          <div>
            <h3 class="text-main-200">Support</h3>

            <nav class="grid gap-3">
              <a href="/#apply" class="hover:text-main-200 hover:underline"
                >Join our clinical team</a
              >
              <a href="/#employers" class="hover:text-main-200 hover:underline"
                >Enquire about secondment</a
              >
              <a href="/services/s1" class="hover:text-main-200 hover:underline"
                >How verification works</a
              >
              <a href="/verify" class="hover:text-main-200 hover:underline"
                >Verify a record reference</a
              >
              <a
                href="mailto:clinicians@medicsupport.network"
                class="hover:text-main-200 hover:underline">clinicians@medicsupport.network</a
              >
              <a
                href="mailto:employers@medicsupport.network"
                class="hover:text-main-200 hover:underline">employers@medicsupport.network</a
              >
            </nav>
          </div>
          <div>
            <h3 class="text-main-200">Services</h3>

            <nav class="grid gap-3">
              <a href="/services/s1" class="hover:text-main-200 hover:underline"
                >Hospital and clinic operations</a
              >
              <a href="/services/s2" class="hover:text-main-200 hover:underline"
                >Emergency and critical care</a
              >
              <a href="/services/s3" class="hover:text-main-200 hover:underline"
                >Maternity and women's health</a
              >
              <a href="/services/s4" class="hover:text-main-200 hover:underline"
                >Diagnostics and imaging</a
              >
              <a href="/services/s5" class="hover:text-main-200 hover:underline"
                >Secondment to Europe and America</a
              >
              <a href="/secondment" class="hover:text-main-200 hover:underline"
                >Working with us in Europe and America</a
              >
              <a href="/about" class="hover:text-main-200 hover:underline">About the group</a>
            </nav>
          </div>
          <div>
            <h3 class="text-main-200">Legal</h3>

            <nav class="grid gap-3">
              <a href="/terms" class="hover:text-main-200 hover:underline"
                >Terms of Use</a
              >
              <a href="/privacy" class="hover:text-main-200 hover:underline"
                >Privacy Policy</a
              >
              <a href="/cookies" class="hover:text-main-200 hover:underline"
                >Cookie Notice</a
              >
              <a href="/governance" class="hover:text-main-200 hover:underline"
                >Clinical Governance</a
              >
            </nav>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="footer-btm w-full">
    <div class="container pb-5">
      <hr class="border-t border-main-200 mb-5" />
      <div class="flex flex-wrap gap-4 items-center justify-between">
<p>
            MedicSupport Network &copy; {copyrightFrom}&ndash;{copyrightTo}. All Rights Reserved
          </p>
      </div>
    </div>
  </div>
</footer>
