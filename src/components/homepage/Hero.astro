---
import { ChevronRight } from "@lucide/astro";
import { HOSPITALS, COUNTRIES, totalBeds } from "../../data/hospitals";

const fmt = (n: number) => n.toLocaleString("en-GB");

// Derived from the facilities file, never hardcoded — same rule as /about.
const firstOpening = HOSPITALS.reduce((a, b) => (b.opened < a.opened ? b : a)).opened;
const yearsTrading = new Date().getFullYear() - firstOpening;

const figures = [
	{ n: String(HOSPITALS.length), l: "Hospitals & clinics" },
	{ n: String(COUNTRIES.length), l: "Countries" },
	{ n: fmt(totalBeds), l: "Licensed beds" },
	{ n: String(yearsTrading), l: "Years, since 2007" },
];
---

<section class="section section-hero py-14 sm:py-20 my-0!">
	<div class="container">
		<p
			class="text-[0.68rem] tracking-[0.18em] uppercase font-bold text-main-200 mb-7"
		>
			MedicSupport Network
		</p>

		<h1
			class="text-[clamp(2.6rem,5.4vw,4.6rem)] leading-[0.98] tracking-[-0.035em]"
		>
			<span class="block">We run</span>
			<span class="block">hospitals.</span>
			<span
				class="block bg-linear-to-r from-[#0179B4] to-[#88D8FF] bg-clip-text text-transparent"
				>And we staff them</span
			>
			<span
				class="block bg-linear-to-r from-[#0179B4] to-[#88D8FF] bg-clip-text text-transparent"
				>with our own people.</span
			>
		</h1>

		<div class="h-px bg-white/20 my-9"></div>

		<div class="grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-x-12 gap-y-9 items-end">
			<div>
				<p class="text-[1.06rem] text-gray-300 max-w-[52ch] leading-relaxed">
					{yearsTrading} years of operating hospitals and clinics across{" "}
					<span class="text-main-200 font-bold">Africa and Asia</span>. The clinicians we
					place in Europe and America are not strangers we sourced — they are our own
					employees, already working in our own licensed facilities, already held to our
					standard.
				</p>
				<div class="flex flex-wrap gap-3.5 mt-7">
					<a
						href="/hospitals"
						class="btn bg-[linear-gradient(125deg,var(--color-main-100),var(--color-main-200))] text-white border-0 rounded-xl text-lg py-3 px-6 h-auto shadow-xl hover:shadow-2xl"
						>See our facilities <ChevronRight /></a
					>
					<a
						href="/secondment"
						class="btn border-2 border-main-200 bg-transparent text-white rounded-xl text-lg py-3 px-6 h-auto shadow-none hover:bg-white hover:text-black hover:border-white"
						>Enquire about secondment</a
					>
				</div>
			</div>

			<div class="grid grid-cols-2 gap-x-8 gap-y-7">
				{
					figures.map((f) => (
						<div>
							<p class="font-[Georgia,serif] text-[2.4rem] leading-none tracking-[-0.03em]">
								{f.n}
							</p>
							<p class="text-[0.68rem] tracking-[0.14em] uppercase font-bold text-main-200 mt-2">
								{f.l}
							</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>