---
import { CircleCheck, Mail, Users, Building2 } from "@lucide/astro";
---

<section class="section my-0! py-10 relative z-0">
	<div class="container relative after:absolute after:-bottom-5 after:left-0 after:bg-[url('/img/shape/shape1.svg')] after:bg-no-repeat after:w-35 after:h-17 after:bg-position-[left_bottom]] after:bg-contain after:-z-10">
		<div class="rounded-2xl border-2 border-main-200 p-4 lg:p-10 bg-[linear-gradient(45deg,#F8FDFF,#FFFFFF)]">
			<h2 class="font-semibold text-main-200 text-2xl text-center">
				Talk to the group.
			</h2>

			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
				<article id="apply" class="border-2 border-main-200 rounded-xl p-6 lg:p-8 bg-white text-black">
					<div class="flex items-center gap-3 text-main-200">
						<Users size={28} />
						<h3 class="text-xl">I am a clinician</h3>
					</div>
					<p class="mt-4">
						Doctors, nurses, midwives and paramedics employed by MedicSupport work in
						our own hospitals across Africa and Asia. If you want to join the group, or
						be considered for secondment to Europe or America, send us your registration
						and licence.
					</p>
					<a
						href="mailto:clinicians@medicsupport.network?subject=Clinician%20enquiry%20%E2%80%94%20MedicSupport%20Network"
						class="btn bg-[linear-gradient(125deg,var(--color-main-100),var(--color-main-200))] text-white border-0 rounded-xl text-lg py-3 px-6 h-auto shadow-xl hover:shadow-2xl mt-6"
						>Send your registration <CircleCheck /></a
					>
					<a href="/ama-boateng" class="block mt-4 text-sm text-main-200 hover:underline">
						See what a verified profile looks like &rarr;
					</a>
				</article>

				<article id="employers" class="border-2 border-main-200 rounded-xl p-6 lg:p-8 bg-white text-black">
					<div class="flex items-center gap-3 text-main-200">
						<Building2 size={28} />
						<h3 class="text-xl">I am a hospital or health system</h3>
					</div>
					<p class="mt-4">
						We second our own clinicians to hospitals and health systems in Europe and
						America, under the same governance and standards applied in our facilities.
						Tell us the role, the grade and the market.
					</p>
					<a
						href="mailto:employers@medicsupport.network?subject=Hospital%20staffing%20requirement%20%E2%80%94%20MedicSupport%20Network"
						class="btn bg-[linear-gradient(125deg,var(--color-main-100),var(--color-main-200))] text-white border-0 rounded-xl text-lg py-3 px-6 h-auto shadow-xl hover:shadow-2xl mt-6"
						>Enquire about secondment <Mail /></a
					>
				</article>
			</div>

			<p class="text-sm mt-8 text-center text-gray-600">
				For anything urgent, call the group office. Both routes above reach
				the same team.
			</p>
		</div>
	</div>
</section>