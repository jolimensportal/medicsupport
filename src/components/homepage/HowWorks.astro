---
import { ChevronRight } from "@lucide/astro";

// Placeholder slots — real portraits land in /public/img/team/ and replace the
// SVG silhouette one file at a time. Roles mirror the staffing mix in the data.
const TEAM_SLOTS = [
	{ role: "Doctor", where: "Ghana", src: "/img/team/doctor.svg" },
	{ role: "Nurse", where: "Nigeria", src: "/img/team/nurse.svg" },
	{ role: "Nurse", where: "Philippines", src: "/img/team/nurse-ph.svg" },
	{ role: "Doctor", where: "South Africa", src: "/img/team/doctor-sa.svg" },
];
---

<style>
	.team-grid {
		position: relative;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 0.75rem;
	}

	.slot {
		position: relative;
		margin: 0;
		border-radius: 0.75rem;
		overflow: hidden;
		background: #030b14;
	}

	.slot img {
		display: block;
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
	}

	.slot figcaption {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 1.75rem 0.9rem 0.8rem;
		background: linear-gradient(180deg, transparent, rgb(3 11 20 / 0.88));
		color: #fff;
	}

	.slot figcaption strong {
		font-size: 0.9rem;
		font-weight: 700;
	}

	.slot figcaption span {
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #a7e2ff;
	}

	.badge {
		position: absolute;
		right: 0;
		bottom: 12%;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.8rem 1.1rem;
		background: #fff;
		color: var(--color-main-200);
		font-size: 1rem;
		font-weight: 600;
		border-radius: 0.75rem;
		box-shadow: 0 12px 30px rgb(3 11 20 / 0.28);
	}

	.pending {
		grid-column: 1 / -1;
		margin: 0.25rem 0 0;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		text-align: center;
		color: #6b7c8c;
	}

	@media (max-width: 40rem) {
		.pending {
			display: none;
		}
	}
</style>

<section class="section relative z-0">
  <div class="container">
    <hgroup class="text-center max-w-5xl mx-auto">
      <h2>
        How <span
          class="bg-linear-to-r from-[#0179B4] to-[#88D8FF] bg-clip-text text-transparent"
          >it works</span
        >
      </h2>
      <p>
        Three steps from a nurse in Kumasi to a verified profile, and from that
        profile to a hospital that can actually check it.
      </p>
    </hgroup>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 mt-10 items-center">
      <div class="grid gap-10 grid-cols-[52px_1fr] relative after:absolute after:top-0 after:left-6.5 after:border-main-200 after:border-dashed after:border-l-2 after:bg-no-repeat after:w-13 after:h-[calc((100%*2)/3+20px)] after:-z-10 order-2 lg:order-1 dark:text-white">
		<div class="w-13 h-13 rounded-full bg-[linear-gradient(45deg,#A7E2FF,#0095DE)] text-white text-xl font-semibold flex items-center justify-center">1</div>
		<div>
			<h3>Work in our hospitals</h3>
			<p>
				Our doctors, nurses, midwives and paramedics are employed directly by the
				group and work in our own licensed facilities across Africa and Asia,
				under a single clinical and governance standard.
			</p>
		</div>
		<div class="w-13 h-13 rounded-full bg-[linear-gradient(45deg,#A7E2FF,#0095DE)] text-white text-xl font-semibold flex items-center justify-center">2</div>
		<div>
			<h3>Verified, and provable</h3>
			<p>
				Every clinician we employ is checked against their registering body.
				MedicSupport-issued credential records are publicly verifiable at
				<code>/verify</code> &mdash; an employer can check one without an
				account or an introduction.
			</p>
		</div>
		<div class="w-13 h-13 rounded-full bg-[linear-gradient(45deg,#A7E2FF,#0095DE)] text-white text-xl font-semibold flex items-center justify-center">3</div>
		<div>
			<h3>Seconded abroad</h3>
			<p>
				Some of our clinicians are seconded to hospitals and health systems in
				Europe and America, carrying the same registration, the same
				governance and the same accountability as they carry at home.
			</p>
		</div>

	  </div>
      <!--
        Portrait grid, pending real staff photography.
        Each panel is the same crop and the same duotone ramp so the set reads
        as deliberate rather than as four unrelated stock photos. To swap in
        real portraits, drop a file per slot into /public/img/team/ and replace
        the <img> src below — the frame and treatment stay as they are.
      -->
      <div class="team-grid order-1 lg:order-2">
        {
          TEAM_SLOTS.map((s) => (
            <figure class="slot">
              <img src={s.src} alt={s.alt} width={320} height={400} loading="lazy" decoding="async" />
              <figcaption>
                <strong>{s.role}</strong>
                <span>{s.where}</span>
              </figcaption>
            </figure>
          ))
        }
        <div class="badge">
          <svg class="icon" width="30" height="30" aria-hidden="true">
            <use xlink:href="#star"></use>
          </svg>
          Same standards, everywhere
        </div>
        <p class="pending">Photography pending — four of our own clinicians, one facility.</p>
      </div>
    </div>
  </div>
</section>