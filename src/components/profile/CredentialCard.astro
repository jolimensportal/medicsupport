---
interface Credential {
	label: string;
	body: string;
	reference?: string;
	status: "active" | "in_progress" | "not_started" | "outstanding";
	statusNote?: string;
	checkedAgainst?: string;
	checkedOn?: Date;
}

interface Props {
	credential: Credential;
	fmt: (date: Date) => string;
}

const { credential: c, fmt } = Astro.props;

const label = {
	active: "Active",
	in_progress: "In progress",
	not_started: "Not started",
	outstanding: "Outstanding",
}[c.status];
---

<article class:list={["cert", c.status]}>
	<div class="k">{c.label}</div>
	<div class="n">{c.body}</div>
	{c.reference && <div class="ref mono">{c.reference}</div>}
	<div class="s">{label}</div>

	{c.checkedAgainst && c.checkedOn ? (
		<div class="chk">
			<svg class="seal" viewBox="0 0 100 100" aria-hidden="true">
				<circle cx="50" cy="50" r="48" fill="#0086C4"></circle>
				<path
					d="M 38.4,18.1 H 61.6 V 38.4 H 81.9 V 61.6 H 61.6 V 81.9 H 38.4 V 61.6 H 18.1 V 38.4 H 38.4 Z"
					fill="#fff"></path>
			</svg>
			<span>Checked against {c.checkedAgainst} <b>{fmt(c.checkedOn)}</b></span>
		</div>
	) : (
		<div class="chk pending">{c.statusNote ?? "Not yet verified."}</div>
	)}
</article>

<style>
	.cert { background: #fff; border: 1px solid #e2dad0; padding: 16px 18px; }
	.cert .k { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: #8a8078; margin-bottom: 7px; }
	.cert .n { font-size: 1rem; font-weight: 700; line-height: 1.35; }
	.cert .ref { margin-top: 8px; color: #005f8c; font-weight: 700; }
	.cert .s { font-size: 0.8rem; color: #1f7a4d; font-weight: 700; margin-top: 7px; }
	.cert.in_progress .s,
	.cert.outstanding .s,
	.cert.not_started .s { color: #9a6b12; }
	.cert .chk {
		display: flex; align-items: flex-start; gap: 7px; font-size: 0.76rem;
		color: #8a8078; margin-top: 9px; padding-top: 9px; border-top: 1px solid #e2dad0;
		line-height: 1.45;
	}
	.cert .chk b { color: #514a42; font-weight: 700; }
	.cert .chk.pending { color: #9a6b12; }
	.seal { width: 15px; height: 15px; flex-shrink: 0; margin-top: 1px; }
</style>