---
interface Credential {
	label: string;
	body: string;
	reference?: string;
	status: "active" | "in_progress" | "not_started" | "outstanding";
	statusNote?: string;
	checkedAgainst?: string;
	checkedOn?: Date;
}

interface Props {
	credential: Credential;
	fmt: (date: Date) => string;
}

const { credential: c, fmt } = Astro.props;

const label = {
	active: "Active",
	in_progress: "In progress",
	not_started: "Not started",
	outstanding: "Outstanding",
}[c.status];

const pending = c.status !== "active";
---

<div class="border-b border-[#e4ddd4] py-6 last:border-b-0">
	<div class="flex justify-between items-baseline gap-5 mb-1.5">
		<span class="text-[0.68rem] tracking-[0.1em] uppercase font-bold text-[#8a8078]"
			>{c.label}</span
		>
		<span
			class:list={[
				"text-[0.8rem] font-bold whitespace-nowrap",
				pending ? "text-[#9a6b12]" : "text-[#1f7a4d]",
			]}
			>{label}</span
		>
	</div>

	<p class="text-[1.18rem] font-bold leading-snug text-[#1a1714]">{c.body}</p>
	{c.reference && <p class="text-[#0086C4] font-bold mono text-[0.95rem] mt-0.5">{c.reference}</p>}

	{c.checkedAgainst && c.checkedOn ? (
		<p class="flex items-center gap-2 text-[0.82rem] text-[#8a8078] mt-2.5 leading-snug">
			<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 100 100" aria-hidden="true">
				<circle cx="50" cy="50" r="48" fill="#0086C4"></circle>
				<path
					d="M 38.4,18.1 H 61.6 V 38.4 H 81.9 V 61.6 H 61.6 V 81.9 H 38.4 V 61.6 H 18.1 V 38.4 H 38.4 Z"
					fill="#fff"></path>
			</svg>
			<span>Checked against {c.checkedAgainst} <b class="text-[#514a42]">{fmt(c.checkedOn)}</b></span>
		</p>
	) : (
		<p class="text-[0.82rem] text-[#9a6b12] mt-2.5 leading-snug">
			{c.statusNote ?? "Not yet verified."}
		</p>
	)}
</div>