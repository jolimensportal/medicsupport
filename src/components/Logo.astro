---
const companyName = "MedicSupport Network";
const markPart = "MedicSupport";
const namePart = "Network";
---

<a href="/" class="flex items-center gap-2" aria-label={`${companyName} home`}>
	<span
		class="font-bold tracking-tight leading-none"
		style="font-size: 1.35rem; color: var(--color-main-200);">{markPart}</span
	><span class="font-normal tracking-tight leading-none" style="font-size: 1.35rem"
		>{namePart}</span
	>
</a>