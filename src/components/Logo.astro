---
/**
 * MedicSupport Network wordmark.
 *
 * The supplied artwork is brand-blue on white, which is correct for a light
 * page and unreadable on the dark one. Both variants are shipped and toggled
 * with the same `dark:` breakpoint the rest of the theme uses
 * (Tailwind v4 -> `prefers-color-scheme`), so the logo follows the OS setting
 * in both places it appears: the header and the footer.
 *
 *   light = white letters + brand-blue cross (for dark backgrounds)
 *   dark  = brand-blue letters + white cross (for light backgrounds)
 */
interface Props {
	variant?: "auto" | "light" | "dark";
	class?: string;
}

const { variant = "auto", class: className = "" } = Astro.props;

const lightSrc = "/brand/wordmark-white.png";
const darkSrc = "/brand/wordmark-blue.png";

const box = 'height: 30px; width: auto;';
const imgProps = {
	width: 1983,
	height: 350,
	loading: "eager",
	decoding: "sync",
};
---

<a
	href="/"
	class:list={["inline-flex items-center", className]}
	aria-label="MedicSupport Network home"
>
	{variant === "auto" && (
		<>
			<img
				{...imgProps}
				class:list={["hidden dark:block", className]}
				style={box}
				src={lightSrc}
				alt="MedicSupport Network"
			/>
			<img
				{...imgProps}
				class:list={["block dark:hidden", className]}
				style={box}
				src={darkSrc}
				alt=""
				aria-hidden="true"
			/>
		</>
	)}
	{variant === "light" && <img {...imgProps} style={box} src={lightSrc} alt="MedicSupport Network" />}
	{variant === "dark" && <img {...imgProps} style={box} src={darkSrc} alt="MedicSupport Network" />}
</a>