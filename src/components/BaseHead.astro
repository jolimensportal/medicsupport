---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/og_1200x630.jpg';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { Font } from 'astro:assets';
import { COUNTRIES } from '../data/hospitals';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  image = FallbackImage,
} = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
<link rel="mask-icon" href="/favicon/favicon.svg" color="#0086C4" />
<meta name="theme-color" content="#0b1220" />
<link rel="manifest" href="/favicon/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.site ?? Astro.url)} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />

<!-- Twitter / X. Note: these must use name=, not property= — Twitter ignores
     the property form, which is why card previews were falling back. -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.site ?? Astro.url)} />
<meta name="twitter:image:alt" content={title} />

<!-- JSON-LD Structured Data
     Derived from the facilities file so figures cannot drift from the site.
     postalAddress, telephone and sameAs are deliberately omitted: those were
     template placeholders inherited from the starter, and publishing them would
     have told search engines a false registered address. Add real values here
     once the entity details in src/data/legal.ts are known. -->
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'MedicalOrganization',
  name: SITE_TITLE,
  url: canonicalURL.href,
  description: SITE_DESCRIPTION,
  logo: new URL('/brand/mark-512.png', Astro.site ?? Astro.url).href,
  foundingDate: '2007',
  medicalSpecialty: ['Emergency', 'Surgery', 'Obstetrics', 'Cardiology', 'Oncology', 'Intensive care'],
  areaServed: COUNTRIES,
})} />